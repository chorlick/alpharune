#pragma once
/// @file version.h
/// Generated by CMake at configure time. Do NOT edit version.h directly —
/// edit version.h.in. The git commit + dirty marker are captured fresh on
/// every `cmake` run; touch CMakeLists.txt or re-run cmake to refresh
/// after new commits.

namespace riftbound {

constexpr const char* kVersion     = "@PROJECT_VERSION@";
constexpr const char* kGitCommit   = "@RIFTBOUND_GIT_COMMIT@";
constexpr const char* kBuildDate   = "@RIFTBOUND_BUILD_DATE@";

/// "v0.1.0+abc1234" or "v0.1.0+abc1234-dirty"
constexpr const char* kVersionTag  = "v@PROJECT_VERSION@+@RIFTBOUND_GIT_COMMIT@";

} // namespace riftbound

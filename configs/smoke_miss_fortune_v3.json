{
  "mode": "train",
  "seed": 46,
  "root_dir": "/workspace/riftbound",
  "registry": "cards/registry.json",
  "training": {
    "legend": "Bounty Hunter",
    "iterations": 8,
    "games_per_iter": 16,
    "num_self_play_workers": 16,

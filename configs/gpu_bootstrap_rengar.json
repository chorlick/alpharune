{
  "mode": "train",
  "seed": 47,
  "root_dir": "/workspace/riftbound",
  "registry": "cards/registry.json",
  "training": {
    "legend": "Pridestalker",
    "iterations": 50,
    "games_per_iter": 16,
    "num_self_play_workers": 16,
    "train_steps_per_iter": 200,
    "batch_size": 256,
    "replay_capacity": 131072,
    "mirror_ratio": 1.0,
    "checkpoint_dir": "checkpoints/gpu_rengar",
    "checkpoint_every_iter": 2,
    "keep_last_n": 25,
    "bootstrap_iters": 20,
    "bootstrap_mcts_sims": 400,
    "self_play_agent": {
      "kind": "mcts",
      "sims": 200
    },
    "deck_pools": {
      "self": [
        "decks/rengar_test.json"
      ],
      "opponent": [
        "decks/khazix_test.json"
      ]
    },
    "devices": ["cuda:0"],
    "train_device": "cuda:0",
    "optimizer": {
      "lr": 3e-4,
      "weight_decay": 1e-4,
      "grad_clip": 1.0
    },
    "mcts": {
      "uct_c": 4.0,
      "dirichlet_fraction": 0.5,
      "temperature": 1.0,
      "temperature_drop_at_decision": 100
    },
    "model": {
      "d_model": 512,
      "encoder_layers": 6,
      "encoder_heads": 8,
      "encoder_ffn_dim": 2048,
      "card_embed_dim": 256,
      "gnn_layers": 2,
      "encoder_dropout": 0.0
    }
  }
}
